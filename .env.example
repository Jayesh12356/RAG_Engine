# =============================================================================
# RAG Engine — Configuration template
#
# 1. Copy this file:           cp .env.example .env
# 2. Fill in the API keys below (left blank on purpose — never commit them).
# 3. Every other default already matches docker-compose.yml so a fresh clone
#    works without further tuning.
#
# Every key here is consumed by app/config.py:Settings. Anything you delete
# falls back to its in-code default.
# =============================================================================

# ── LLM ─────────────────────────────────────────────────────────────────────
# Pick the provider you actually have a key for; failover walks the rest.
LLM_PROVIDER=openrouter
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=xiaomi/mimo-v2-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Embeddings ──────────────────────────────────────────────────────────────
# All three providers must agree on EMBEDDING_DIM. The dim guard in
# app/llm/client.py drops any provider whose model dim does not match during
# failover (e.g. Cohere v3 = 1024, OpenRouter Gemini = 768, OpenAI 3-small = 1536).
EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENROUTER_EMBEDDING_MODEL=google/gemini-embedding-001
COHERE_API_KEY=
COHERE_EMBEDDING_MODEL=embed-english-v3.0
EMBEDDING_DIM=1536

# ── Vector DB ───────────────────────────────────────────────────────────────
# docker-compose maps host 6334 -> container 6333 (HTTP).
# Set QDRANT_API_KEY only when pointing at Qdrant Cloud.
VECTOR_DB=qdrant
QDRANT_URL=http://localhost:6334
QDRANT_API_KEY=
QDRANT_COLLECTION=helpdesk_chunks
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=helpdesk_chunks

# ── Relational DB ───────────────────────────────────────────────────────────
# DATABASE_URL is preferred in production (postgres:// is auto-normalised to
# the async SQLAlchemy form). Locally, POSTGRES_URL is enough.
# docker-compose maps host 5433 -> container 5432 with user/pass/db = helpdesk.
DATABASE_URL=
DB_SCHEMA=public
RELATIONAL_DB=postgres
POSTGRES_URL=postgresql+asyncpg://helpdesk:helpdesk@localhost:5433/helpdesk
MYSQL_URL=mysql+aiomysql://helpdesk:helpdesk@localhost:3307/helpdesk

# ── Re-ranking ──────────────────────────────────────────────────────────────
COHERE_RERANK_MODEL=rerank-english-v3.0

# ── App ─────────────────────────────────────────────────────────────────────
DEMO_MODE=false
LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_CHUNKS_RETURN=20
RERANK_TOP_N=8
CONFIDENCE_THRESHOLD=0.40
RELEVANCE_MIN_TOP_SCORE=0.22
RELEVANCE_MIN_SECOND_SCORE=0.12
RELEVANCE_MIN_SCORE_GAP=0.03
QUERY_STREAM_CHUNK_SIZE=40
LLM_REQUEST_TIMEOUT_SEC=25.0
LLM_RETRY_ATTEMPTS=2

# ── Hybrid retrieval (Qdrant) ──────────────────────────────────────────────
HYBRID_RRF_K=60
HYBRID_DENSE_LIMIT=50
HYBRID_SPARSE_LIMIT=50
SPARSE_INDEX_DIR=data/sparse_index

# ── Diversification (MMR) ──────────────────────────────────────────────────
MMR_ENABLED=true
MMR_LAMBDA=0.7
MAX_PER_DOC=2

# ── Citations ──────────────────────────────────────────────────────────────
INCLUDE_CITATIONS_DEFAULT=false

# ── Calibrated confidence + extractive fallback ────────────────────────────
MIN_FALLBACK_OVERLAP=0.20
EXTRACTIVE_FALLBACK_CONFIDENCE=0.45

# ── Query rewriting ────────────────────────────────────────────────────────
QUERY_REWRITE_ENABLED=false
QUERY_REWRITE_TRIGGER_SCORE=0.40

# ── Intent-driven retrieval tuning ─────────────────────────────────────────
INTENT_TROUBLESHOOT_TOP_K_BOOST=6
INTENT_HOWTO_TOP_K_BOOST=4

# ── Ingestion ──────────────────────────────────────────────────────────────
CHUNK_SIZE=1024
CHUNK_OVERLAP=128
EMBED_BATCH_SIZE=32
HEADING_AWARE_CHUNKING=true
PDF_STORAGE_BACKEND=relational
PDF_VECTOR_COLLECTION=helpdesk_pdf_files
PDF_VECTOR_CHUNK_BYTES=60000
PDF_IMAGE_PAGE_CHAR_THRESHOLD=60
PDF_IMAGE_RATIO_THRESHOLD=0.6
OCR_ENABLED=true
# OCR_MODE: tesseract | vision | hybrid
OCR_MODE=hybrid
OCR_LANGUAGES=eng+hin
OCR_RENDER_DPI=300
OCR_TEXT_CONFIDENCE_THRESHOLD=0.35
OCR_VISION_FALLBACK_ENABLED=true
OCR_VISION_MODEL=gpt-4o-mini
# Windows: full path to tesseract.exe (typically C:\Program Files\Tesseract-OCR\tesseract.exe).
# macOS / Linux: leave empty to use the binary on PATH.
TESSERACT_CMD=

# ── Chat session storage ───────────────────────────────────────────────────
CHAT_HISTORY_TURNS=5
MAX_SESSIONS=100
